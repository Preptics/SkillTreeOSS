# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings → API). The anon key is public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Canonical origin used for metadata, sitemap and robots.txt. Leave unset locally;
# production defaults to https://skilltree.preptics.com (lib/site.ts).
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origin used to build the GitHub OAuth callback URL (must match the OAuth app).
APP_URL=http://localhost:3000

# "Submit as PR" from the builder. Only needed if you work on the submission flow.
# Bot token: fine-grained PAT with contents + pull requests write on Preptics/SkillTreeOSS only.
GITHUB_BOT_TOKEN=your_github_bot_token_for_anonymous_contributions
# GitHub OAuth app for "connect GitHub" (callback: {APP_URL}/api/github/callback).
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
# Optional: separate secret for signing the OAuth state (falls back to GITHUB_CLIENT_SECRET).
# GITHUB_OAUTH_SECRET=
